#!/bin/sh
set -e

DATA_DIR=/var/lib/proxy-scaler
SVC_USER=proxy-scaler

case "$1" in
  configure)
    if ! getent passwd "$SVC_USER" >/dev/null; then
      adduser --system --group --no-create-home \
              --home "$DATA_DIR" \
              --gecos "proxy-scaler server" \
              "$SVC_USER" >/dev/null
    fi

    mkdir -p "$DATA_DIR"
    chown -R "$SVC_USER":"$SVC_USER" "$DATA_DIR"
    chmod 750 "$DATA_DIR"

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      # Deliberately never auto-enable/start on a fresh install — running
      # via the CLI (`proxy-scaler-serve`, installed at /usr/bin) is the
      # default expectation, not an always-on background service. Only
      # restart if the service was already enabled by an earlier, explicit
      # `systemctl enable --now proxy-scaler` — that's an upgrade picking
      # up the new binary for someone who opted into the persistent
      # service, not this script deciding to start one.
      if systemctl is-enabled --quiet proxy-scaler.service 2>/dev/null; then
        systemctl restart proxy-scaler.service >/dev/null 2>&1 || true
      fi
    fi

    cat <<'EOF'

proxy-scaler is installed. It is NOT running yet — this is a CLI tool,
not an always-on service by default.

  Run it directly:
    proxy-scaler-serve --port 8000

  Or, if you want it running persistently in the background as a
  systemd service instead:
    sudo systemctl enable --now proxy-scaler

  Either way: the API has no authentication. Anyone who can reach the
  port can read and write projects and queue generation work on this
  machine. Only bind beyond 127.0.0.1 on a network you trust — Tailscale
  or similar, not the open internet.

  Service config (only used if you enable the service): /etc/default/proxy-scaler
  Data:   /var/lib/proxy-scaler
  Logs:   journalctl -u proxy-scaler (service) or your own terminal (CLI)

EOF
    ;;

  abort-upgrade | abort-remove | abort-deconfigure) ;;
esac

exit 0
