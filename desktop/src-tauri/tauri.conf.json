{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxy-scaler-spike",
  "version": "0.1.0",
  "identifier": "com.proxyscaler.spike",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "command": "npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Proxy Scaler",
        "url": "index.html",
        "width": 1280,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/proxy-scaler-serve"]
  }
}
