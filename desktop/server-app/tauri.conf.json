{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxy Scaler Server",
  "version": "0.1.0",
  "identifier": "com.proxyscaler.server",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Proxy Scaler Server",
        "url": "index.html",
        "width": 560,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
