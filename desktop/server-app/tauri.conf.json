{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxy Scaler Server",
  "version": "0.1.0",
  "identifier": "com.proxyscaler.server",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
