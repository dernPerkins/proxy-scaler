{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the server app's status window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "proxy-scaler-serve",
          "cmd": "proxy-scaler-serve/proxy-scaler-serve",
          "sidecar": false,
          "args": true
        }
      ]
    }
  ]
}
